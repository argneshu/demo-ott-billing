{
  "evalFrameworkVersion": "1.0.0",
  "scope": "changed-files",
  "retryLimitForSelfRepair": 3,
  "thresholds": {
    "lintErrorsAllowedDelta": 0,
    "typeErrorsAllowed": 0,
    "semgrepFindingsAllowed": {
      "critical": 0,
      "high": 0,
      "medium": 5
    },
    "dependencyVulnerabilitiesAllowed": {
      "critical": 0,
      "high": 0
    },
    "disallowedLicenses": [
      "GPL-2.0",
      "GPL-3.0",
      "AGPL-3.0",
      "SSPL-1.0"
    ],
    "maxCyclomaticComplexity": 12,
    "secretFindingsAllowed": 0,
    "unitTestCoverageMin": 90.0,
    "behaviorScenarioPassRateMin": 100.0,
    "llmJudgeArchitectureScoreMin": 0.85,
    "llmJudgeSecurityScoreMin": 0.85,
    "securityVulnerabilitiesAllowed": 0
  },
  "behavior": {
    "containerRuntime": "podman",
    "image": "aire-behavior:local",
    "containerfile": "tests/.evals/behavior/Containerfile",
    "entrypoint": "tests/.evals/behavior/run.sh",
    "_comment": "Same image + command locally and in CI. A missing runtime degrades to native execution, recorded, never blocking."
  },
  "sonarqube": {
    "enabled": false,
    "_comment": "Set true when CI generation creates sonar-project.properties and the user answers proceed at the setup gate. Additive to semgrep, never a replacement."
  },
  "playwright": {
    "enabled": false,
    "startCommand": null,
    "readinessUrl": null,
    "testCommand": "npx playwright test tests/e2e/",
    "backendStartCommand": null,
    "backendReadinessUrl": null,
    "_comment": "Set true, with startCommand/readinessUrl resolved, the first time a work unit runs the Playwright UI Automation Gate for real. This project needs frontend and backend as two processes, so backendStartCommand/backendReadinessUrl are resolved then too."
  },
  "judge": {
    "model": "claude-sonnet-5-5",
    "rubricVersion": "1.0.0"
  },
  "ci": {
    "baseBranch": "main",
    "integrationBranchPrefixes": [
      "epic",
      "bug",
      "enh",
      "ci",
      "story",
      "ve"
    ],
    "manifestState": "resolved",
    "roots": [
      {
        "root": "src/backend",
        "stack": "python",
        "runtimeVersion": "3.14",
        "markerFile": "requirements.txt",
        "installCommands": [
          "pip install -r requirements.txt -r requirements-dev.txt"
        ],
        "buildCommand": null,
        "coverageCommand": "pytest --cov=. --cov-report=xml ../../tests/unit",
        "noTestsExitCode": 5,
        "dependsOn": [],
        "toolchainSetup": [],
        "coverageReportPath": "coverage.xml",
        "coverageFormat": "cobertura",
        "sourcePaths": [
          "src/backend"
        ],
        "testPaths": [
          "tests/unit"
        ],
        "tools": [],
        "toolInstallCommands": {}
      },
      {
        "root": "src/frontend",
        "stack": "node",
        "runtimeVersion": "20",
        "markerFile": "package.json",
        "installCommands": [
          "npm ci"
        ],
        "buildCommand": "npm run build",
        "coverageCommand": "npx vitest run --coverage --passWithNoTests",
        "dependsOn": [],
        "toolchainSetup": [],
        "coverageReportPath": "coverage/lcov.info",
        "coverageFormat": "lcov",
        "sourcePaths": [
          "src/frontend/src"
        ],
        "testPaths": [
          "src/frontend/src"
        ],
        "tools": [],
        "toolInstallCommands": {}
      }
    ],
    "gates": [
      "D1_lint",
      "D2_types",
      "D3_sast",
      "D4_deps",
      "D5_licenses",
      "D6_complexity",
      "D7_secrets",
      "unitCoverage",
      "behaviorB1",
      "behaviorB2",
      "behaviorB3",
      "J1_architecture",
      "J2_security"
    ],
    "_comment": "CI is not enabled for this project (user opt-out). This block is still the single source for the local gates. Roots reflect the approved NFR stack (pytest, Vitest); tools and toolInstallCommands are empty until the first work unit resolves and verifies them for real, never invented."
  }
}
